generator client {
  provider = "prisma-client-js"
}

enum PrepMilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

model PrepMilestone {
  id           String              @id @default(cuid())
  sessionId    String
  title        String
  description  String?
  dueAt        DateTime?
  status       PrepMilestoneStatus @default(NOT_STARTED)
  assignedToId String?
  completedAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  session      ExaminationSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assignedTo   User?               @relation("MilestoneAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([sessionId, dueAt])
}

model SessionSchoolReminder {
  id         String             @id @default(cuid())
  sessionId  String
  schoolId   String
  sentById   String
  lastSentAt DateTime           @default(now())
  sentCount  Int                @default(1)
  session    ExaminationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  school     School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([sessionId, schoolId])
}

enum ExamMaterialStatus {
  SUBMITTED
  CHANGES_REQUIRED
  APPROVED
}

model ExamMaterialSubmission {
  id              String             @id @default(cuid())
  sessionId       String
  subjectCode     String
  submittedById   String
  scriptKey       String
  scriptName      String
  scriptMimeType  String
  scriptSizeBytes Int
  guideKey        String
  guideName       String
  guideMimeType   String
  guideSizeBytes  Int
  status          ExamMaterialStatus @default(SUBMITTED)
  reviewNote      String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime           @default(now())
  session         ExaminationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  submittedBy     User               @relation("MaterialSubmitter", fields: [submittedById], references: [id])
  reviewedBy      User?              @relation("MaterialReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([sessionId, subjectCode, status])
  @@index([submittedById, createdAt])
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Access control ----------
enum UserType {
  STAFF
  SCHOOL
}

model User {
  id                 String                   @id @default(cuid())
  email              String                   @unique
  passwordHash       String
  fullName           String
  phone              String?
  userType           UserType                 @default(STAFF)
  isActive           Boolean                  @default(true)
  mustChangePassword Boolean                  @default(false)
  // Set only for SCHOOL users. Always read from the database on the server, never from the browser.
  schoolId           String?
  school             School?                  @relation(fields: [schoolId], references: [id])
  roles              UserRole[]
  failedLogins       Int                      @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  resetTokens        PasswordReset[]
  assignedMilestones PrepMilestone[]          @relation("MilestoneAssignee")
  submittedMaterials ExamMaterialSubmission[] @relation("MaterialSubmitter")
  reviewedMaterials  ExamMaterialSubmission[] @relation("MaterialReviewer")

  @@index([schoolId])
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  userType    UserType         @default(STAFF)
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String
  roles       RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Organisation ----------
model ExaminationCentre {
  id       String   @id @default(cuid())
  code     String   @unique
  name     String
  address  String?
  isActive Boolean  @default(true)
  schools  School[]
}

model School {
  id            String                     @id @default(cuid())
  code          String                     @unique
  name          String
  address       String?
  email         String?
  phone         String?
  isActive      Boolean                    @default(true)
  centreId      String?
  centre        ExaminationCentre?         @relation(fields: [centreId], references: [id])
  users         User[]
  candidates    Candidate[]
  resultBatches ResultBatch[]
  submissions   CandidateSubmission[]
  nominations   ExaminerNomination[]
  distributions ResultDistributionSchool[]
  reminders     SessionSchoolReminder[]
  createdAt     DateTime                   @default(now())
}

enum SessionStatus {
  PLANNED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  EXAM_ONGOING
  RESULTS_PROCESSING
  COMPLETED
}

// "Examination Session" in the interface
model ExaminationSession {
  id                 String                   @id @default(cuid())
  name               String
  year               Int
  status             SessionStatus            @default(PLANNED)
  registrationOpens  DateTime?
  registrationCloses DateTime?
  examStarts         DateTime?
  examEnds           DateTime?
  subjects           SessionSubject[]
  submissions        CandidateSubmission[]
  nominations        ExaminerNomination[]
  candidates         Candidate[]
  resultBatches      ResultBatch[]
  prepMilestones     PrepMilestone[]
  schoolReminders    SessionSchoolReminder[]
  examMaterials      ExamMaterialSubmission[]
  createdAt          DateTime                 @default(now())

  @@unique([name, year])
}

model Subject {
  id         String                @id @default(cuid())
  code       String                @unique
  name       String
  category   String?
  maxMark    Int                   @default(100)
  isActive   Boolean               @default(true)
  papers     SubjectPaper[]
  sessions   SessionSubject[]
  groupLinks SubjectGroupSubject[]
}

model SubjectPaper {
  id        String  @id @default(cuid())
  subjectId String
  number    Int
  code      String  @unique
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, number])
}

// "Subject Group": a set of subjects with a minimum and maximum number a student may take
model SubjectGroup {
  id          String                @id @default(cuid())
  name        String                @unique
  minSubjects Int                   @default(1)
  maxSubjects Int                   @default(10)
  subjects    SubjectGroupSubject[]
}

model SubjectGroupSubject {
  groupId   String
  subjectId String
  group     SubjectGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject   Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([groupId, subjectId])
}

model SessionSubject {
  sessionId String
  subjectId String
  session   ExaminationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  subject   Subject            @relation(fields: [subjectId], references: [id])

  @@id([sessionId, subjectId])
}

// ---------- Students: submission -> row -> official record ----------
enum SubmissionStatus {
  NOT_SUBMITTED
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUIRED
  APPROVED
  REJECTED
}

model CandidateSubmission {
  id             String                      @id @default(cuid())
  schoolId       String
  sessionId      String
  status         SubmissionStatus            @default(NOT_SUBMITTED)
  fileName       String?
  totalRecords   Int                         @default(0)
  validRecords   Int                         @default(0)
  invalidRecords Int                         @default(0)
  reviewNote     String?
  submittedById  String
  reviewedById   String?
  submittedAt    DateTime                    @default(now())
  reviewedAt     DateTime?
  school         School                      @relation(fields: [schoolId], references: [id])
  session        ExaminationSession          @relation(fields: [sessionId], references: [id])
  records        CandidateSubmissionRecord[]

  @@index([schoolId, sessionId])
}

model CandidateSubmissionRecord {
  id           String              @id @default(cuid())
  submissionId String
  rowNumber    Int
  raw          Json
  errors       Json?
  isValid      Boolean             @default(true)
  submission   CandidateSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

// Official record. Created only when a submission is approved by ACEITEKA staff.
model Candidate {
  id                 String             @id @default(cuid())
  registrationNumber String
  fullName           String
  dateOfBirth        DateTime?
  gender             String?
  schoolId           String
  sessionId          String
  subjectCodes       String[]
  createdAt          DateTime           @default(now())
  school             School             @relation(fields: [schoolId], references: [id])
  session            ExaminationSession @relation(fields: [sessionId], references: [id])
  results            Result[]

  @@unique([sessionId, registrationNumber])
  @@index([schoolId])
}

// ---------- Examiners: nomination / profile / appointment are three separate things ----------
enum NominationStatus {
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUIRED
  APPROVED
  REJECTED
}

model ExaminerNomination {
  id             String             @id @default(cuid())
  schoolId       String
  sessionId      String
  fullName       String
  email          String?
  phone          String?
  nationalId     String?
  subjectCode    String
  qualifications String
  experience     String?
  status         NominationStatus   @default(SUBMITTED)
  reviewNote     String?
  reviewedById   String?
  reviewedAt     DateTime?
  profileId      String?
  createdAt      DateTime           @default(now())
  school         School             @relation(fields: [schoolId], references: [id])
  session        ExaminationSession @relation(fields: [sessionId], references: [id])
  profile        ExaminerProfile?   @relation(fields: [profileId], references: [id])
  documents      UploadedFile[]

  @@index([schoolId])
}

model ExaminerProfile {
  id             String                @id @default(cuid())
  fullName       String
  email          String?
  phone          String?
  nationalId     String?               @unique
  subjectCodes   String[]
  qualifications String
  verifiedAt     DateTime              @default(now())
  nominations    ExaminerNomination[]
  appointments   ExaminerAppointment[]
}

model ExaminerAppointment {
  id           String          @id @default(cuid())
  profileId    String
  sessionId    String
  subjectCode  String
  role         String          @default("Examiner")
  assignedById String
  status       String          @default("ASSIGNED")
  createdAt    DateTime        @default(now())
  profile      ExaminerProfile @relation(fields: [profileId], references: [id])

  @@unique([profileId, sessionId, subjectCode])
}

// ---------- Results: entered -> checked -> approved -> released ----------
enum ResultStatus {
  DRAFT
  SUBMITTED_FOR_CHECK
  CHECKED
  SUBMITTED_FOR_APPROVAL
  APPROVED
  CHANGES_REQUIRED
  REJECTED
  RELEASED
}

model ResultBatch {
  id            String                     @id @default(cuid())
  sessionId     String
  subjectCode   String
  paperCode     String                     @default("")
  schoolId      String?
  status        ResultStatus               @default(DRAFT)
  enteredById   String
  checkedById   String?
  approvedById  String?
  releasedById  String?
  note          String?
  checkedAt     DateTime?
  approvedAt    DateTime?
  releasedAt    DateTime?
  session       ExaminationSession         @relation(fields: [sessionId], references: [id])
  school        School?                    @relation(fields: [schoolId], references: [id])
  results       Result[]
  distributions ResultDistributionSchool[]
  createdAt     DateTime                   @default(now())

  @@unique([sessionId, subjectCode, paperCode, schoolId])
}

model Result {
  id          String             @id @default(cuid())
  batchId     String
  candidateId String
  mark        Int?
  grade       String?
  batch       ResultBatch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  candidate   Candidate          @relation(fields: [candidateId], references: [id])
  corrections ResultCorrection[]

  @@unique([batchId, candidateId])
}

model ResultCorrection {
  id            String   @id @default(cuid())
  resultId      String
  oldMark       Int?
  newMark       Int?
  reason        String
  correctedById String
  approvedById  String?
  createdAt     DateTime @default(now())
  result        Result   @relation(fields: [resultId], references: [id])
}

model ResultDistributionSchool {
  id            String      @id @default(cuid())
  batchId       String
  schoolId      String
  releasedAt    DateTime    @default(now())
  firstViewedAt DateTime?
  downloadCount Int         @default(0)
  batch         ResultBatch @relation(fields: [batchId], references: [id])
  school        School      @relation(fields: [schoolId], references: [id])

  @@unique([batchId, schoolId])
}

// ---------- Communication ----------
model Announcement {
  id            String   @id @default(cuid())
  title         String
  body          String
  audience      String   @default("GENERAL")
  departmentKey String?
  createdById   String
  createdAt     DateTime @default(now())

  @@index([audience, departmentKey, createdAt])
}

model Message {
  id         String    @id @default(cuid())
  schoolId   String
  fromSchool Boolean   @default(false)
  senderId   String
  subject    String
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([schoolId])
}

// ---------- Files and audit ----------
model UploadedFile {
  id           String              @id @default(cuid())
  storageKey   String              @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  uploadedById String
  schoolId     String?
  nominationId String?
  nomination   ExaminerNomination? @relation(fields: [nominationId], references: [id])
  createdAt    DateTime            @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
